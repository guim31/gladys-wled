{
  "manifest_version": 1,
  "type": "device",
  "name": "WLED",
  "description": {
    "en": "WLED LED strip controllers on the local network: colors, effects, palettes, presets, segments.",
    "fr": "Contrôleurs de rubans LED WLED en réseau local : couleurs, effets, palettes, préréglages, segments."
  },
  "version": "1.0.2",
  "docker_image": "ghcr.io/guim31/gladys-wled:1.0.2",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-wled/main/cover.png",
  "categories": ["lighting"],
  "transports": ["local"],
  "network_discovery": [{ "type": "mdns", "service": "_wled._tcp" }],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Finding your controllers", "fr": "Trouver vos contrôleurs" },
      "description": {
        "en": "WLED controllers on the same network as Gladys are found automatically (mDNS): open the Discovery tab. If one is missing, enter its IP address below (shown in the WLED app, under Config, WiFi Setup).",
        "fr": "Les contrôleurs WLED du même réseau que Gladys sont trouvés automatiquement (mDNS) : ouvrez l'onglet Découverte. S'il en manque un, saisissez son adresse IP ci-dessous (affichée dans l'application WLED, Config, WiFi Setup)."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-wled/blob/main/docs/en.md",
          "label": { "en": "Setup guide", "fr": "Guide d'installation" }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": { "en": "Controller IP addresses", "fr": "Adresses IP des contrôleurs" },
      "description": {
        "en": "Optional, separated by commas. Only needed for the controllers automatic discovery does not find.",
        "fr": "Facultatif, séparées par des virgules. Seulement pour les contrôleurs que la découverte automatique ne trouve pas."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50, 192.168.1.51",
        "fr": "ex. 192.168.1.50, 192.168.1.51"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "segment_devices",
      "type": "select",
      "label": { "en": "Segments", "fr": "Segments" },
      "description": {
        "en": "Each controller is one device, driving the segments selected in WLED (the whole strip when there is only one). You can also get one device per segment.",
        "fr": "Chaque contrôleur est un appareil, qui pilote les segments sélectionnés dans WLED (tout le ruban s'il n'y en a qu'un). Vous pouvez aussi obtenir un appareil par segment."
      },
      "required": false,
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": { "en": "One device per controller", "fr": "Un appareil par contrôleur" }
        },
        {
          "value": "all",
          "label": {
            "en": "Also one device per segment",
            "fr": "Aussi un appareil par segment"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités"
      },
      "description": {
        "en": "Names given to the features of new devices (Light, Brightness, Effect...).",
        "fr": "Noms donnés aux fonctionnalités des nouveaux appareils (Éclairage, Luminosité, Effet…)."
      },
      "required": false,
      "default": "en",
      "options": [
        { "value": "en", "label": { "en": "English", "fr": "Anglais" } },
        { "value": "fr", "label": { "en": "French", "fr": "Français" } }
      ]
    }
  ],
  "actions": [
    {
      "key": "search",
      "label": { "en": "Search for controllers", "fr": "Rechercher les contrôleurs" },
      "description": {
        "en": "Looks for WLED controllers again and reports the ones found.",
        "fr": "Recherche à nouveau les contrôleurs WLED et liste ceux trouvés."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "preset_activated",
      "label": { "en": "WLED preset activated", "fr": "Préréglage WLED activé" },
      "description": {
        "en": "A preset or playlist was started outside Gladys: from the WLED app, a button, a schedule or a remote.",
        "fr": "Un préréglage ou une playlist a été lancé hors de Gladys : depuis l'application WLED, un bouton, une planification ou une télécommande."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Controller", "fr": "Contrôleur" }
        },
        {
          "key": "preset",
          "type": "string",
          "label": { "en": "Preset name", "fr": "Nom du préréglage" },
          "description": {
            "en": "Leave empty for any preset.",
            "fr": "Laisser vide pour n'importe quel préréglage."
          }
        }
      ],
      "variables": [
        {
          "key": "preset",
          "type": "string",
          "label": { "en": "Preset name", "fr": "Nom du préréglage" }
        },
        {
          "key": "preset_id",
          "type": "number",
          "label": { "en": "Preset number", "fr": "Numéro du préréglage" }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "apply_preset",
      "label": { "en": "Apply a WLED preset", "fr": "Appliquer un préréglage WLED" },
      "description": {
        "en": "Applies a preset or starts a playlist saved on the controller, given by its name or number.",
        "fr": "Applique un préréglage ou lance une playlist enregistrés sur le contrôleur, désignés par leur nom ou leur numéro."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Controller", "fr": "Contrôleur" },
          "required": true
        },
        {
          "key": "preset",
          "type": "string",
          "label": { "en": "Preset name or number", "fr": "Nom ou numéro du préréglage" },
          "placeholder": { "en": "e.g. Evening", "fr": "ex. Soirée" },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "preset_id",
          "type": "number",
          "label": { "en": "Preset number", "fr": "Numéro du préréglage" }
        },
        {
          "key": "preset_name",
          "type": "string",
          "label": { "en": "Preset name", "fr": "Nom du préréglage" }
        }
      ]
    },
    {
      "key": "start_effect",
      "label": { "en": "Start a WLED effect", "fr": "Lancer un effet WLED" },
      "description": {
        "en": "Turns the light on and starts an effect, given by its name or number, with an optional palette, speed and intensity.",
        "fr": "Allume la lumière et lance un effet, désigné par son nom ou son numéro, avec palette, vitesse et intensité facultatives."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Controller or segment", "fr": "Contrôleur ou segment" },
          "required": true
        },
        {
          "key": "effect",
          "type": "string",
          "label": { "en": "Effect name or number", "fr": "Nom ou numéro de l'effet" },
          "placeholder": { "en": "e.g. Rainbow", "fr": "ex. Rainbow" },
          "required": true
        },
        {
          "key": "palette",
          "type": "string",
          "label": { "en": "Palette (optional)", "fr": "Palette (facultative)" },
          "placeholder": { "en": "e.g. Party", "fr": "ex. Party" },
          "required": false
        },
        {
          "key": "speed",
          "type": "number",
          "label": { "en": "Speed (0-100, optional)", "fr": "Vitesse (0-100, facultative)" },
          "required": false,
          "min": 0,
          "max": 100
        },
        {
          "key": "intensity",
          "type": "number",
          "label": { "en": "Intensity (0-100, optional)", "fr": "Intensité (0-100, facultative)" },
          "required": false,
          "min": 0,
          "max": 100
        }
      ],
      "outputs": [
        {
          "key": "effect_id",
          "type": "number",
          "label": { "en": "Effect number", "fr": "Numéro de l'effet" }
        },
        {
          "key": "effect_name",
          "type": "string",
          "label": { "en": "Effect name", "fr": "Nom de l'effet" }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "wled",
      "label": { "en": "WLED", "fr": "WLED" },
      "description": {
        "en": "Favorite presets and chosen effects in one tap, with the current effect, palette and preset.",
        "fr": "Préréglages favoris et effets choisis en un geste, avec effet, palette et préréglage en cours."
      },
      "icon": "sun",
      "action_timeout_seconds": 15,
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "WLED device", "fr": "Appareil WLED" },
          "required": true
        },
        {
          "key": "effects",
          "type": "multi_select",
          "label": { "en": "Effect buttons", "fr": "Boutons d'effets" },
          "description": {
            "en": "Effects shown as one-tap buttons, when the controller has them (four buttons at most with the favorite presets).",
            "fr": "Effets affichés en boutons, quand le contrôleur les a (quatre boutons au plus avec les préréglages favoris)."
          },
          "required": false,
          "default": ["Solid", "Rainbow"],
          "options": [
            { "value": "Solid", "label": { "en": "Solid", "fr": "Solid" } },
            { "value": "Rainbow", "label": { "en": "Rainbow", "fr": "Rainbow" } },
            { "value": "Colorloop", "label": { "en": "Colorloop", "fr": "Colorloop" } },
            { "value": "Breathe", "label": { "en": "Breathe", "fr": "Breathe" } },
            { "value": "Candle", "label": { "en": "Candle", "fr": "Candle" } },
            { "value": "Fire 2012", "label": { "en": "Fire 2012", "fr": "Fire 2012" } },
            { "value": "Twinkle", "label": { "en": "Twinkle", "fr": "Twinkle" } },
            { "value": "Aurora", "label": { "en": "Aurora", "fr": "Aurora" } },
            { "value": "Fireworks", "label": { "en": "Fireworks", "fr": "Fireworks" } },
            { "value": "Meteor", "label": { "en": "Meteor", "fr": "Meteor" } },
            { "value": "Pacifica", "label": { "en": "Pacifica", "fr": "Pacifica" } },
            { "value": "Lake", "label": { "en": "Lake", "fr": "Lake" } }
          ]
        }
      ]
    }
  ]
}
